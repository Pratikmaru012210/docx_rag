# ==========================================================
# FMCG SOP RAG Application - Environment Variables
# ==========================================================

# 1. Groq API (Free Tier from https://console.groq.com/keys)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-20b

# 2. Gemini embeddings (https://aistudio.google.com/apikey)
GEMINI_AI_API=your_gemini_api_key_here
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# 3. ChromaDB HTTP server (start with: chroma run --path ./chroma_db --port 8001)
CHROMA_HOST=localhost
CHROMA_PORT=8001
CHROMA_COLLECTION_NAME=fmcg-sop-rag

# 4. Browser origins allowed to call the API (comma-separated)
CORS_ORIGINS=http://localhost:5173

# 5. Document chunking
MAX_CHUNK_WORDS=350
CHUNK_OVERLAP_WORDS=50
