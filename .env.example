# ==========================================================
# FMCG SOP RAG Application - Environment Variables
# ==========================================================

# 1. Groq API (Free Tier from https://console.groq.com/keys)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-20b

# 2. Pinecone Vector Database (Free Tier from https://app.pinecone.io/)
PINECONE_API_KEY=your_pinecone_api_key_here
PINECONE_INDEX_NAME=fmcg-sop-rag
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1

# 3. Browser origins allowed to call the API (comma-separated)
CORS_ORIGINS=http://localhost:5173

# 4. Embedding Model (Pinecone Serverless Inference)
# Options: multilingual-e5-large (1024 dims) or llama-text-embed-v2 (1024 dims)
EMBEDDING_MODEL=multilingual-e5-large
EMBEDDING_DIMENSION=1024

# 5. Document chunking
MAX_CHUNK_WORDS=350
CHUNK_OVERLAP_WORDS=50
